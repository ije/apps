+typedef void (*JSInspectorMessageCallback)(void* data, const char* message, size_t length);
+typedef void (*JSInspectorPauseCallback)(JSGlobalContextRef ctx, bool* done);
+
+/*!
+@function
+@abstract Connects a Web Inspector protocol frontend to a context. Call the other inspector functions on the context's thread.
+@param ctx The JSGlobalContext to inspect.
+@param message Receives every protocol response and event as UTF-8 JSON.
+@param pause Runs while the debugger is paused. It must dispatch messages until done is true.
+@param data Passed to message.
+@result The connection, for JSGlobalContextDisconnectInspector.
+*/
+JS_EXPORT void* JSGlobalContextConnectInspector(JSGlobalContextRef ctx, JSInspectorMessageCallback message, JSInspectorPauseCallback pause, void* data);
+
+/*!
+@function
+@abstract Sends a UTF-8 JSON protocol message to the context's inspector.
+*/
+JS_EXPORT void JSGlobalContextDispatchInspectorMessage(JSGlobalContextRef ctx, const char* message, size_t length);
+
+/*!
+@function
+@abstract Disconnects and frees a connection from JSGlobalContextConnectInspector. Call it before the context is released.
+*/
+JS_EXPORT void JSGlobalContextDisconnectInspector(JSGlobalContextRef ctx, void* connection);
