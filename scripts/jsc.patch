+// Like browsers: absolute URLs stay, and "/", "./" and "../" resolve against the importing module's URL.
+Identifier JSAPIGlobalObject::moduleLoaderResolve(JSGlobalObject* globalObject, JSModuleLoader*, JSValue key, JSValue referrer, RefPtr<ScriptFetcher>, bool)
+{
+    VM& vm = globalObject->vm();
+    auto scope = DECLARE_THROW_SCOPE(vm);
+    String name = key.toWTFString(globalObject);
+    RETURN_IF_EXCEPTION(scope, { });
+    URL url { name };
+    if (!url.isValid()) {
+        URL base;
+        if (auto* string = dynamicDowncast<JSString>(referrer)) {
+            String value = string->value(globalObject);
+            RETURN_IF_EXCEPTION(scope, { });
+            base = URL { { }, value };
+        }
+        if (!name.startsWith('/') && !name.startsWith("./"_s) && !name.startsWith("../"_s)) {
+            throwVMError(globalObject, scope, createTypeError(globalObject, makeString("Cannot resolve module specifier \""_s, name, "\". Use a URL"_s)));
+            return { };
+        }
+        url = URL { base, name };
+        if (!base.isValid() || !url.isValid()) {
+            throwVMError(globalObject, scope, createTypeError(globalObject, makeString("Cannot resolve \""_s, name, "\" from \""_s, base.string(), "\""_s)));
+            return { };
+        }
+    }
+    return Identifier::fromString(vm, url.string());
+}
+
+JSPromise* JSAPIGlobalObject::moduleLoaderImportModule(JSGlobalObject* globalObject, JSModuleLoader*, JSString* specifierValue, RefPtr<ScriptFetchParameters> fetchParams, const SourceOrigin& sourceOrigin, bool deferred)
+{
+    VM& vm = globalObject->vm();
+    auto scope = DECLARE_THROW_SCOPE(vm);
+    auto reject = [&] {
+        auto* promise = JSPromise::create(vm, globalObject->promiseStructure());
+        return promise->rejectWithCaughtException(vm, scope);
+    };
+    auto specifier = specifierValue->value(globalObject);
+    RETURN_IF_EXCEPTION(scope, reject());
+    Identifier origin;
+    if (const String& string = sourceOrigin.string(); !string.isNull())
+        origin = Identifier::fromString(vm, string);
+    auto* result = importModule(globalObject, Identifier::fromString(vm, specifier), origin, WTF::move(fetchParams), nullptr, deferred);
+    RETURN_IF_EXCEPTION(scope, reject());
+    return result;
+}
+
+// Calls the loader function with (url, resolve, reject). resolve takes the module source as a string.
+JSPromise* JSAPIGlobalObject::moduleLoaderFetch(JSGlobalObject* globalObject, JSModuleLoader*, JSValue key, const String&, RefPtr<ScriptFetchParameters>, RefPtr<ScriptFetcher>)
+{
+    VM& vm = globalObject->vm();
+    auto scope = DECLARE_THROW_SCOPE(vm);
+    auto* promise = JSPromise::create(vm, globalObject->promiseStructure());
+    String url = key.toWTFString(globalObject);
+    RETURN_IF_EXCEPTION(scope, promise->rejectWithCaughtException(vm, scope));
+    JSObject* loader = uncheckedDowncast<JSAPIGlobalObject>(globalObject)->m_moduleLoader.get();
+    if (!loader) {
+        scope.release();
+        promise->reject(vm, createTypeError(globalObject, makeString("Cannot import "_s, url)));
+        return promise;
+    }
+    auto* resolve = JSNativeStdFunction::create(vm, globalObject, 1, "resolve"_s, [promise, url] (JSGlobalObject* globalObject, CallFrame* callFrame) {
+        VM& vm = globalObject->vm();
+        auto scope = DECLARE_THROW_SCOPE(vm);
+        String source = callFrame->argument(0).toWTFString(globalObject);
+        RETURN_IF_EXCEPTION(scope, encodedJSValue());
+        URL origin { { }, url };
+        promise->resolve(globalObject, vm, JSSourceCode::create(vm, makeSource(source, SourceOrigin { origin }, SourceTaintedOrigin::Untainted, url, TextPosition(), SourceProviderSourceType::Module)));
+        return encodedJSUndefined();
+    }, promise);
+    auto* reject = JSNativeStdFunction::create(vm, globalObject, 1, "reject"_s, [promise] (JSGlobalObject* globalObject, CallFrame* callFrame) {
+        promise->reject(globalObject->vm(), callFrame->argument(0));
+        return encodedJSUndefined();
+    }, promise);
+    auto callData = JSC::getCallData(loader);
+    MarkedArgumentBuffer arguments;
+    arguments.append(key);
+    arguments.append(resolve);
+    arguments.append(reject);
+    call(globalObject, loader, callData, jsUndefined(), arguments);
+    RETURN_IF_EXCEPTION(scope, promise->rejectWithCaughtException(vm, scope));
+    return promise;
+}
+
+JSObject* JSAPIGlobalObject::moduleLoaderCreateImportMetaProperties(JSGlobalObject* globalObject, JSModuleLoader*, JSValue key, JSModuleRecord*, RefPtr<ScriptFetcher>)
+{
+    VM& vm = globalObject->vm();
+    JSObject* meta = constructEmptyObject(vm, globalObject->nullPrototypeObjectStructure());
+    meta->putDirect(vm, Identifier::fromString(vm, "url"_s), key);
+    return meta;
+}
