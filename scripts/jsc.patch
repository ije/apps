+bool JSValueGetBytes(JSContextRef ctx, JSValueRef value, void** bytes, size_t* length)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    JSLockHolder locker(globalObject);
+    JSValue jsValue = toJS(globalObject, value);
+    if (!jsValue.isCell())
+        return false;
+    if (auto* view = dynamicDowncast<JSArrayBufferView>(jsValue.asCell())) {
+        *bytes = view->vector();
+        *length = view->isOutOfBounds() ? 0 : view->byteLength();
+        return true;
+    }
+    if (auto* buffer = dynamicDowncast<JSArrayBuffer>(jsValue.asCell())) {
+        *bytes = buffer->impl()->data();
+        *length = buffer->impl()->byteLength();
+        return true;
+    }
+    return false;
+}
+
+JSObjectRef JSObjectMakeUint8ArrayUninitialized(JSContextRef ctx, size_t length, void** bytes, JSValueRef* exception)
+{
+    JSLockHolder locker(toJS(ctx));
+    JSGlobalObject* globalObject = toJS(ctx);
+    VM& vm = globalObject->vm();
+    auto scope = DECLARE_TOP_EXCEPTION_SCOPE(vm);
+    auto* array = JSUint8Array::createUninitialized(globalObject, globalObject->typedArrayStructure(TypeUint8, false), length);
+    if (handleExceptionIfNeeded(scope, ctx, exception) == ExceptionStatus::DidThrow || !array)
+        return nullptr;
+    *bytes = array->typedVector();
+    return toRef(array);
+}
