+}
+const void* JSValueGetStringCharacters(JSContextRef ctx, JSValueRef value, size_t* length, bool* latin1)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    VM& vm = globalObject->vm();
+    JSLockHolder locker(vm);
+    auto scope = DECLARE_TOP_EXCEPTION_SCOPE(vm);
+
+    JSValue jsValue = toJS(globalObject, value);
+    if (!jsValue.isString())
+        return nullptr;
+    const String& string = asString(jsValue)->value(globalObject).data;
+    if (handleExceptionIfNeeded(scope, ctx, nullptr) == ExceptionStatus::DidThrow)
+        return nullptr;
+    *length = string.length();
+    *latin1 = string.is8Bit() || string.isEmpty();
+    if (string.isEmpty())
+        return "";
+    return string.is8Bit() ? static_cast<const void*>(string.span8().data()) : static_cast<const void*>(string.span16().data());
+}
+
+JSValueRef JSValueMakeStringLatin1(JSContextRef ctx, const unsigned char* characters, size_t length)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    VM& vm = globalObject->vm();
+    JSLockHolder locker(vm);
+    if (length > JSString::MaxLength)
+        return nullptr;
+    if (!length)
+        return toRef(globalObject, jsEmptyString(vm));
+    return toRef(globalObject, jsString(vm, String(unsafeMakeSpan(byteCast<Latin1Character>(characters), length))));
+}
+
+JSValueRef JSValueMakeStringUTF16(JSContextRef ctx, const unsigned short* characters, size_t length)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    VM& vm = globalObject->vm();
+    JSLockHolder locker(vm);
+    if (length > JSString::MaxLength)
+        return nullptr;
+    if (!length)
+        return toRef(globalObject, jsEmptyString(vm));
+    return toRef(globalObject, jsString(vm, String(unsafeMakeSpan(reinterpret_cast<const char16_t*>(characters), length))));
+}
+
+JSValueRef JSValueMakeStringUTF8(JSContextRef ctx, const char* bytes, size_t length)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    VM& vm = globalObject->vm();
+    JSLockHolder locker(vm);
+    if (length > JSString::MaxLength)
+        return nullptr;
+    if (!length)
+        return toRef(globalObject, jsEmptyString(vm));
+    if (simdutf::validate_ascii(bytes, length))
+        return toRef(globalObject, jsString(vm, String(unsafeMakeSpan(byteCast<Latin1Character>(bytes), length))));
+    String string;
+    if (simdutf::validate_utf8(bytes, length)) {
+        std::span<char16_t> characters;
+        if (auto impl = StringImpl::tryCreateUninitialized(simdutf::utf16_length_from_utf8(bytes, length), characters)) {
+            (void)simdutf::convert_valid_utf8_to_utf16le(bytes, length, characters.data());
+            string = WTF::move(impl);
+        }
+    } else
+        string = String::fromUTF8ReplacingInvalidSequences(unsafeMakeSpan(byteCast<char8_t>(bytes), length));
+    if (string.isNull())
+        return nullptr;
+    return toRef(globalObject, jsString(vm, WTF::move(string)));
+}
+
+size_t JSStringConvertCharactersToUTF8(const void* characters, size_t length, bool latin1, char* output)
+{
+    if (!output)
+        return latin1 ? simdutf::utf8_length_from_latin1(static_cast<const char*>(characters), length) : simdutf::utf8_length_from_utf16le(static_cast<const char16_t*>(characters), length);
+    if (latin1)
+        return simdutf::convert_latin1_to_utf8(static_cast<const char*>(characters), length, output);
+    return simdutf::convert_utf16le_to_utf8(static_cast<const char16_t*>(characters), length, output);
+}
