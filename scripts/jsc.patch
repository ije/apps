+// The bytes must be Latin-1 and must outlive the VM, because the source keeps pointing at them. The bytecode, from
+// JSScriptCreateBytecodeLatin1 or null, must outlive every VM. JSC compiles the source when the bytecode doesn't match it.
+extern "C" JS_EXPORT JSValueRef JSEvaluateScriptLatin1(JSContextRef ctx, const char* script, size_t length, JSObjectRef thisObject, JSStringRef sourceURLString, const uint8_t* bytecode, size_t bytecodeSize, JSValueRef* exception);
+JSValueRef JSEvaluateScriptLatin1(JSContextRef ctx, const char* script, size_t length, JSObjectRef thisObject, JSStringRef sourceURLString, const uint8_t* bytecode, size_t bytecodeSize, JSValueRef* exception)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    JSLockHolder locker(globalObject->vm());
+
+    auto sourceURL = sourceURLString ? URL({ }, sourceURLString->string()) : URL();
+    String text(StringImpl::createWithoutCopying(std::span { script, length }));
+    SourceCode source = bytecode
+        ? SourceCode(adoptRef(*new BytecodeSourceProvider(text, sourceURL, std::span { bytecode, bytecodeSize })))
+        : makeSource(text, SourceOrigin { sourceURL }, SourceTaintedOrigin::Untainted, sourceURL.string(), TextPosition(OrdinalNumber::fromOneBasedInt(1), OrdinalNumber()));
+
+    return JSEvaluateScriptInternal(locker, ctx, thisObject, source, exception);
+}
+
+// Compiles the script and all of its functions, and returns their bytecode in a malloc() block, or null when the
+// script has a syntax error.
+extern "C" JS_EXPORT uint8_t* JSScriptCreateBytecodeLatin1(JSContextRef ctx, const char* script, size_t length, JSStringRef sourceURLString, size_t* size);
+uint8_t* JSScriptCreateBytecodeLatin1(JSContextRef ctx, const char* script, size_t length, JSStringRef sourceURLString, size_t* size)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    VM& vm = globalObject->vm();
+    JSLockHolder locker(vm);
+
+    auto sourceURL = sourceURLString ? URL({ }, sourceURLString->string()) : URL();
+    SourceCode source = makeSource(String(StringImpl::createWithoutCopying(std::span { script, length })), SourceOrigin { sourceURL }, SourceTaintedOrigin::Untainted, sourceURL.string(), TextPosition(OrdinalNumber::fromOneBasedInt(1), OrdinalNumber()));
+    FileSystem::FileHandle memory;
+    BytecodeCacheError error;
+    RefPtr<CachedBytecode> bytecode = generateProgramBytecode(vm, source, memory, error);
+    if (!bytecode || error.isValid())
+        return nullptr;
+    auto* copy = static_cast<uint8_t*>(malloc(bytecode->size()));
+    memcpy(copy, bytecode->span().data(), bytecode->size());
+    *size = bytecode->size();
+    return copy;
+}
