+
+void* JSGlobalContextConnectInspector(JSGlobalContextRef ctx, JSInspectorMessageCallback message, JSInspectorPauseCallback pause, void* data)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    JSLockHolder locker(globalObject->vm());
+    apiInspectorPauseCallback = pause;
+    auto* channel = new JSAPIInspectorChannel(message, data);
+    globalObject->inspectorController().connectFrontend(*channel, false, false);
+    return channel;
+}
+
+void JSGlobalContextDispatchInspectorMessage(JSGlobalContextRef ctx, const char* message, size_t length)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    JSLockHolder locker(globalObject->vm());
+    globalObject->inspectorController().dispatchMessageFromFrontend(String::fromUTF8(std::span { message, length }));
+    // The debugger exists once Debugger.enable ran. Without this callback a pause would wait on a run loop that never cycles.
+    if (auto* debugger = globalObject->debugger()) {
+        static_cast<Inspector::JSGlobalObjectDebugger*>(debugger)->runWhilePausedCallback = [](JSGlobalObject& globalObject, bool& done) {
+            apiInspectorPauseCallback(toGlobalRef(&globalObject), &done);
+        };
+    }
+}
+
+void JSGlobalContextDisconnectInspector(JSGlobalContextRef ctx, void* connection)
+{
+    JSGlobalObject* globalObject = toJS(ctx);
+    JSLockHolder locker(globalObject->vm());
+    auto* channel = static_cast<JSAPIInspectorChannel*>(connection);
+    globalObject->inspectorController().disconnectFrontend(*channel);
+    delete channel;
+}
